review:
  ignoredPaths:
    - "*.lock"
    - "generated/**"
    - "vendor/**"

  ignoredCategories:
    - "CODE_STYLE"

  minimumConfidence: 0.60

limits:
  maxDiffLines: 5000
  maxFileLines: 1500

llm:
  provider: openai
  model: gpt-4o-mini

