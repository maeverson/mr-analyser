# Copy this file to .mranalyser.properties and fill the values.

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Option A: OpenAI hosted
# MR_ANALYSER_LLM_PROVIDER=openai
# MR_ANALYSER_LLM_MODEL=gpt-4o-mini
# MR_ANALYSER_LLM_API_KEY=
# MR_ANALYSER_LLM_URL=https://api.openai.com/v1

# Option B: Self-hosted Ollama (recommended for local stack)
MR_ANALYSER_LLM_PROVIDER=ollama
MR_ANALYSER_LLM_MODEL=qwen25-coder-rag:latest
MR_ANALYSER_LLM_API_KEY=
MR_ANALYSER_LLM_URL=http://192.168.15.50:11434

MR_ANALYSER_MAX_CONCURRENCY=4
